#!/usr/bin/env bash
# stdin: {"args": ["log", ...], "content": "..."}

# sib edit opens $EDITOR on the item; write the given content instead
if [[ ${1:-} == --write ]]; then
    printf '%s' "$SIB_TOOL_CONTENT" >"$2"
    exit
fi

input=$(cat)

args=()
while IFS= read -r -d '' arg; do
    args+=("$arg")
done < <(jq -j '.args[]? | tostring, "\u0000"' <<<"$input")

# Asking from inside sib ask would recurse and move HEAD under it
if [[ ${args[0]:-} == ask ]]; then
    echo 'sib ask is not allowed from this tool'
    exit 1
fi

if jq -e 'has("content")' >/dev/null <<<"$input"; then
    SIB_TOOL_CONTENT=$(jq -j .content <<<"$input")
    export SIB_TOOL_CONTENT EDITOR="$0 --write"
fi

exec sib ${args[@]+"${args[@]}"} 2>&1 </dev/null
