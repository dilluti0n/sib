set -euo pipefail

NAME="$(basename -- "$0")"

die() {
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: ${NAME} [-ch] [-k <key>] [-n <lines>] [<chain-ish>]
  -n <lines>  Truncate content to <lines>
  -k <key>    Only show <key>'s value on <chain-ish>
  -c          Same as \`-k content'
  -h          Show this help
EOF
}

n_lines= key=
while getopts hn:k:c o; do
    case $o in
        h) usage; exit 0 ;;
        n) n_lines="$OPTARG" ;;
        k) key="$OPTARG" ;;
        c) key=content   ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

target="${1:-HEAD}"

chain=$(sib rev-parse "$target")

if [[ ! -z $key ]]; then
    blob=$(sib ls-trace "$chain" \
        | awk -F'\t' -v k="$key" '$2 == k { print $1 }')
    [[ -n $blob ]] || die "no key '$key' on $chain"
    sib git cat-file blob "$blob"
    exit 0
fi

exec sib-log -1 ${n_lines:+-n "$n_lines"} "$chain"
