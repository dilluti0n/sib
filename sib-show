set -euo pipefail

NAME="$(basename -- "$0")"

die() {
    # shellcheck disable=SC2319 # also reached after [[ ]], which is never 141
    [ $? -ne 141 ] || exit 141  # reader closed the pipe (SIGPIPE)
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: ${NAME} [-h] [<chain-ish>[:<key>]]
  Show <chain-ish> (default HEAD), or only the value of <key> on it
  -h          Show this help
EOF
}

while getopts h o; do
    case $o in
        h) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -le 1 ]] || { usage >&2; exit 1; }
target="${1:-HEAD}"

# Split <chain-ish>:<key> at the first ':' outside @{...}, which may
# hold a date like @{10:00}
chain_ish=$target key= has_key=
rest=$target pre=
while [[ $rest == *:* ]]; do
    pre+=${rest%%:*}
    rest=${rest#*:}
    opens=${pre//[^\{]/} closes=${pre//[^\}]/}
    if (( ${#opens} == ${#closes} )); then
        chain_ish=$pre key=$rest has_key=1
        break
    fi
    pre+=:
done

chain=$(sib rev-parse "$chain_ish") || exit 1

if [[ -n $has_key ]]; then
    [[ -n $key ]] || die "no key given: $target"
    blob=$(sib ls-trace "$chain" \
        | awk -F'\t' -v k="$key" '$2 == k { print $1 }')
    [[ -n $blob ]] || die "no key '$key' on $chain_ish"
    sib git cat-file blob "$blob"
    exit 0
fi

exec sib-log "$chain^!"
