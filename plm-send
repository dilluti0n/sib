#!/usr/bin/env bash
set -o pipefail

: "${PLM_ENDPOINT:?PLM_ENDPOINT is not set}"

# print message to fd 3, response to stdout; fall back to stderr
{ : >&3; } 2>/dev/null || exec 3>&2

auth_header=()
[[ -n ${PLM_API_KEY:-} ]] && auth_header=(-H "Authorization: Bearer ${PLM_API_KEY}")

curl -sS -N -i "$PLM_ENDPOINT" -H "Content-Type: application/json" "${auth_header[@]}" \
     --retry "${PLM_RETRY:-3}" --retry-delay 1 --data-binary @- | {
    shopt -s nocasematch

    # HTTP headers; skip 1xx interim responses
    status= ctype=
    while IFS= read -r line; do
        line=${line%$'\r'}
        case $line in
            HTTP/*)         status=${line#* }; status=${status%% *} ;;
            content-type:*) ctype=${line#*:}; ctype=${ctype# } ;;
            '')             [[ $status == 1* ]] || break ;;
        esac
    done

    if [[ $status != 2* ]]; then
        echo "Non-successful response: HTTP $status" >&2
        printf '%s\n' "$(cat)" >&3
        exit 1
    fi

    case $ctype in
        application/json*)
            res=$(cat)
            printf '%s\n' "$res"
            jq -r '.output[]? | select(.type == "message") | .content[0].text' <<<"$res" >&3
            exit
            ;;
        text/event-stream*) ;;
        *)
            echo "unexpected content-type: ${ctype:-(none)}" >&2
            printf '%s\n' "$(cat)" >&3
            exit 1
            ;;
    esac

    current_event=
    { printf '%s\n' "$line"; cat; } | while IFS= read -r line; do
        line=${line%$'\r'}
        case $line in
            event:*)
                current_event=${line#event:}
                current_event=${current_event# }
                ;;
            data:*)
                payload=${line#data:}
                payload=${payload# }
                case $current_event in
                    response.output_text.delta)
                        jq -rj '.delta // empty' <<<"$payload" >&3
                        ;;
                    response.output_text.done)
                        printf '\n' >&3
                        ;;
                    response.completed)
                        jq '.response' <<<"$payload"
                        ;;
                    *)
                        if [[ -n ${PLM_DEBUG:-} ]]; then
                            echo "event: $current_event" >&3
                            echo "data: $payload" >&3
                        fi
                        ;;
                esac
                ;;
        esac
    done
}
