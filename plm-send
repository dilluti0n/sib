#!/usr/bin/env bash
set -o pipefail

: "${PLM_ENDPOINT:?PLM_ENDPOINT is not set}"

# print message to fd 3, response to stdout; fall back to stderr
{ : >&3; } 2>/dev/null || exec 3>&2

# one line per function call
fc_line='"function_call: \(.name)(\(.arguments))"'

# PLM_HEADER_CMD prints the auth headers, in place of PLM_API_KEY.
# Run it before curl so a failure stops the request.
if [[ -n ${PLM_HEADER_CMD:-} ]]; then
    auth=$(sh -c "$PLM_HEADER_CMD") || {
        echo "header command failed: $PLM_HEADER_CMD" >&2
        exit 1
    }
elif [[ -n ${PLM_API_KEY:-} ]]; then
    auth="Authorization: Bearer $PLM_API_KEY"
fi

# Read headers from a file so the key does not show up in argv (ps, /proc)
headers() {
    echo 'Content-Type: application/json'
    [[ -z ${auth:-} ]] || printf '%s\n' "$auth"
}

curl -sS -N -i "$PLM_ENDPOINT" -H @<(headers) \
     --retry "${PLM_RETRY:-3}" --retry-delay 1 --data-binary @- | {
    shopt -s nocasematch

    # HTTP headers; skip 1xx interim responses
    status= ctype=
    while IFS= read -r line; do
        line=${line%$'\r'}
        case $line in
            HTTP/*)         status=${line#* }; status=${status%% *} ;;
            content-type:*) ctype=${line#*:}; ctype=${ctype# } ;;
            '')             [[ $status == 1* ]] || break ;;
        esac
    done

    if [[ $status != 2* ]]; then
        echo "Non-successful response: HTTP $status" >&2
        printf '%s\n' "$(cat)" >&3
        exit 1
    fi

    case $ctype in
        application/json*)
            res=$(cat)
            printf '%s\n' "$res"
            jq -r ".output[]? |
                   if .type == \"reasoning\" then (.summary[]? | .text + \"\\n\")
                   elif .type == \"message\" then .content[0].text
                   elif .type == \"function_call\" then $fc_line
                   else empty end" <<<"$res" >&3
            # The response is out; a failed display does not undo it
            exit 0
            ;;
        text/event-stream*) ;;
        *)
            echo "unexpected content-type: ${ctype:-(none)}" >&2
            printf '%s\n' "$(cat)" >&3
            exit 1
            ;;
    esac

    tmp=$(mktemp) || exit
    trap 'rm -f "$tmp"' EXIT

    # Display deltas as they arrive with a single jq. If the display
    # reader goes away, drain the rest so the response still lands.
    sed -u 's/\r$//; /^data:/!d; s/^data: \{0,1\}//' | tee "$tmp" | {
        jq --unbuffered -Rrj --arg debug "${PLM_DEBUG:-}" "fromjson? |
            if .type == \"response.output_text.delta\" then .delta // empty
            elif .type == \"response.output_text.done\" then \"\\n\"
            elif .type == \"response.reasoning_summary_text.delta\" then .delta // empty
            elif .type == \"response.reasoning_summary_text.done\" then \"\\n\\n\"
            elif .type == \"response.output_item.done\" then
                .item | select(.type == \"function_call\") | $fc_line + \"\\n\"
            elif \$debug != \"\" then \"event: \\(.type)\\ndata: \\(tojson)\\n\"
            else empty end" >&3 || cat >/dev/null; }

    last=$(jq -Rc 'fromjson? | select(.type == "response.completed"
                                      or .type == "response.incomplete"
                                      or .type == "response.failed"
                                      or .type == "error")' "$tmp" | tail -n 1)

    case $(jq -r '.type // empty' <<<"$last") in
        response.completed)
            jq '.response' <<<"$last"
            ;;
        response.incomplete)
            echo "incomplete response: $(jq -r '.response.incomplete_details.reason // "unknown"' <<<"$last")" >&2
            jq '.response' <<<"$last"
            ;;
        response.failed)
            echo "response failed: $(jq -r '.response.error | "\(.code // "unknown"): \(.message // "")"' <<<"$last")" >&2
            exit 1
            ;;
        error)
            echo "stream error: $(jq -r '"\(.code // "unknown"): \(.message // .error.message // "")"' <<<"$last")" >&2
            exit 1
            ;;
        *)
            echo "stream ended without response" >&2
            exit 1
            ;;
    esac
}
