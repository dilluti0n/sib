set -euo pipefail

NAME="$(basename -- "$0")"

die() {
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: ${NAME} [-nrcjh] [-p <chain-ish>] [-t <name>] [-e <endpoint>] [-m <model>]
  -e     API <endpoint> (PLM_ENDPOINT)
  -m     Model name (PLM_MODEL)
  -p     Parent <chain-ish> to chain on (default HEAD)
  -t     Save the current HEAD as <name> before asking
  -n     Start new conversation
  -r     Do not accept or chain input (use with -p)
  -c     Chain user turn only, no API call done
  -j     Read input as plm jsonl (e.g. function_call_output items)
  -h     Show this help

Function calls are answered with \`sib tool run' until the model
replies with a message. Exit status is 10 when a function_call is
left because its tool cannot run.
Tools are read from the JSON file PLM_TOOLS (config sib.tools,
default \$SIB_DIR/tools/tools.json);
PLM_TOOL_CHOICE sets tool_choice.
EOF
}

parent=HEAD parent_arg= resend= ref= only_chain= noderef= input_format=text
while getopts he:m:p:t:nrcj o; do
    case $o in
        h) usage; exit 0 ;;
        e) export PLM_ENDPOINT="$OPTARG" ;;
        m) export PLM_MODEL="$OPTARG" ;;
        p) parent="$OPTARG" ;;
        t) ref="$OPTARG" ;;
        n) parent= ;;
        r) resend=1 ;;
        c) only_chain=1 ;;
        j) input_format=plm ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

[[ -z $resend || $input_format == text ]] || die '-r and -j cannot be used together'

[[ -n $ref ]] && sib save -- "$ref"

if [[ -z $parent ]]; then
    # -n is set, should detach HEAD to not taint existing ref
    noderef=--no-deref
elif tmp=$(sib rev-parse "$parent" 2>/dev/null); then
    parent=$tmp
elif [[ $parent == HEAD ]]; then
    # An unborn HEAD has no parent. Follow it only if it points to a
    # symbolic ref made by `sib switch -f'.
    parent=
    case $(sib symbolic-ref -q HEAD) in
        refs/conv/*) ;;
        *) noderef=--no-deref ;;
    esac
else
    die "bad parent: $parent"
fi

if [[ -z $resend ]]; then
    [[ -t 0 ]] && echo '(stdin, Ctrl+D to send)' >&2

    # rev-parse prints empty means there is no ref pointed to by
    # $parent. In this case, start a new chain and update HEAD.
    parent_arg="${parent:+-p $parent}"
    parent=$(plm-wrap -f $input_format -t plm | sib chain-jsonl $parent_arg) ||
        die 'fail to chain input'
fi

[[ -n $parent ]] || die 'refuse to do worthless job with -nr'

# Items like function_call_output may have no content
reflog=$(sib show -c $parent 2>/dev/null | tr -s '[:space:]' ' ' | cut -c1-72) || :

[[ -n $only_chain ]] && {
    sib update-ref -m "ask (user): ${reflog:-$parent}" $noderef HEAD $parent
    exit
}

while :; do
    {
        res=$(sib rev-jsonl $parent \
                  | plm-wrap -f plm -t request \
                  | plm-send) || die 'fail to recieve API call'

        [[ -n $res ]] || die 'fail to recieve API call'

        [[ -z "${SIB_DEBUG:-}" ]] || echo "sib-ask: res: $res" >&2
    } 3>&1

    new=$(plm-wrap -f response -t plm <<<"$res" | sib chain-jsonl -p $parent) ||
        die something wrong
    [[ -n $new ]] || die "sib chain-jsonl -p $parent gives empty output"

    sib update-ref -m "ask: ${reflog:-$new}" $noderef HEAD $new

    [[ $(sib ls-trace-json $new | jq -r '.type // empty') == function_call ]] || break

    # The model is waiting for tool output. Run the tools and ask again;
    # if they cannot run, leave HEAD on the call for the caller.
    out=$(sib tool pending $new | sib tool run) || exit 10

    # A tool may have moved HEAD (e.g. sib edit); continue from there
    new=$(sib rev-parse HEAD)
    parent=$(sib chain-jsonl -p $new <<<"$out") || exit 10
    reflog="tool output of $new"
    sib update-ref -m "ask (tool): $new" $noderef HEAD $parent
done
