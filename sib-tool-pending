set -euo pipefail

NAME="$(basename -- "$0")"

die() {
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: ${NAME} [-h] [<chain-ish>]

Print function_call items on <chain-ish> (default HEAD) that have no
function_call_output with the same call_id, as plm jsonl.
  -h    Show this help
EOF
}

while getopts h o; do
    case $o in
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -le 1 ]] || { usage >&2; exit 1; }

chain=$(sib rev-parse "${1:-HEAD}" 2>/dev/null) || die "invalid chain: ${1:-HEAD}"

sib rev-jsonl "$chain" | jq -c -s '
    [ .[] | select(.type == "function_call_output") | .call_id ] as $done
    | .[]
    | select(.type == "function_call" and (.call_id as $id | $done | index($id) | not))'
