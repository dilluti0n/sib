set -o pipefail

: "${SIB_DIR:=$HOME/.sib}"
export SIB_DIR

readonly DEFAULT_PLM_MODEL=gpt-6-luna
readonly DEFAULT_PLM_ENDPOINT=https://api.openai.com/v1/responses
readonly COMMIT_DATE='999999999 +0000'

die() {
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

lgit() {
    env GIT_AUTHOR_NAME='Sibyl' \
        GIT_COMMITTER_NAME='Sibyl' \
        GIT_AUTHOR_EMAIL='sib@local' \
        GIT_COMMITTER_EMAIL='sib@local' \
        git --git-dir="$SIB_DIR" "$@"
}

cmd_init() {
    [[ $# -eq 0 ]] || die 'no argument is allowed'

    local reinit=
    [[ -f "$SIB_DIR/HEAD" ]] && reinit=true

    mkdir -p "$SIB_DIR" || die "cannot create $SIB_DIR"
    lgit init --bare --quiet || die "cannot init $SIB_DIR"

    if [[ -z $reinit ]]; then
        echo 'ref: refs/conv/scratch' > "$SIB_DIR/HEAD"
        cat <<EOF >> "$SIB_DIR/config"
[sib]
        vendor = openai
[vendor "openai"]
        endpoint = $DEFAULT_PLM_ENDPOINT
        model = $DEFAULT_PLM_MODEL
EOF
        echo "Initialized empty Sib store in $SIB_DIR" >&2
    else
        echo "Reinitialized existing Sib store in $SIB_DIR" >&2
    fi
}

key_is_valid() {
    [[ $1 =~ ^[A-Za-z_][A-Za-z0-9._:-]*$ ]]
}

tf_key() {
    local line key hash n=0

    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))

        IFS=$'\t' read -r hash key <<<"$line"

        [[ -n $key && -n $hash ]] || {
            echo "invalid trace entry at line $n" >&2
            return 1
        }

        key_is_valid "$key" || {
            echo "invalid trace key at line $n: $key" >&2
            return 1
        }

        echo "$key"
    done
}

# chain-trace [-p <chain>] <trace>
cmd_chain_trace() {
    local parent_args=() trace=

    if [[ $# -eq 1 ]]; then
        trace="$1"
    elif [[ $# -eq 3 && "$1" == "-p" ]]; then
        parent_args=(-p "$(cmd_rev_parse "$2")") || exit 1
        trace="$3"
    else
        die "Usage: chain-trace [-p <chain>] <trace>"
    fi

    # check if trace is valid
    cmd_ls_trace "$trace" >/dev/null

    GIT_AUTHOR_DATE="$COMMIT_DATE" \
    GIT_COMMITTER_DATE="$COMMIT_DATE" \
    lgit commit-tree "${parent_args[@]}" "$trace" </dev/null
}

# shellcheck disable=SC2120 # invoked via cmd_* dispatch
cmd_mktrace() {
    [[ $# -eq 0 ]] || die 'no argument is allowed'
    local lines line key hash keys

    lines=$(cat)

    if [[ -n $lines ]]; then
        keys=$(printf '%s\n' "$lines" | tf_key) || die 'invalid trace format'

        printf '%s\n' "$keys" | sort | uniq -d | grep -q . &&
            die 'duplicate key found in input'
    fi

    if [[ -n $lines ]]; then
        while IFS=$'\t' read -r hash key; do
            printf '100644 blob %s\t%s\n' "$hash" "$key"
        done <<<"$lines"
    fi | lgit mktree || die Invalid mktrace format
}

cmd_ls_trace() {
    [[ $# -eq 1 ]] || die 'usage: ls-trace <trace>'
    [[ $1 =~ ^[0-9a-f]{4,40}$ ]] || die "not an object id: $1"

    local tmp keys

    tmp="$(lgit ls-tree "$1" 2>/dev/null)" || die "invalid object name $1"
    tmp=$(awk 'NF==4 { OFS="\t"; print $3, $4 }' <<<"$tmp")

    # Now $tmp is ls-trace format before screening

    [[ -z $tmp ]] && return 0 # empty trace

    keys=$(tf_key <<<"$tmp") || die 'invalid trace format'

    printf '%s\n' "$keys" | sort | uniq -d | grep -q . &&
            die "duplicate key found in trace $1"

    printf '%s\n' "$tmp"
}

cmd_git() {
    lgit "$@"
}

# hash and format blob (to trace format)
# $1: blob name
tf_blob() {
    local key=$1 hash

    [[ -n $key ]] || return 1
    hash=$(lgit hash-object -w --stdin) || return
    printf '%s\t%s\n' "$hash" "$key"
}

# Input: {"key": "value", "key": "value", ...}
# shellcheck disable=SC2120 # invoked via cmd_* dispatch
cmd_mktrace_json() {
    [[ $# -eq 0 ]] || die 'no argument is allowed'

    local json tr

    json=$(cat)

    # Reject null/array/object/non-object
    jq -se 'length == 1 and (.[0] | type == "object" and all(.[]; type == "string"))' \
        >/dev/null <<<"$json" \
        || die 'input must be a JSON object containing only string values'

    tr=$(jq -r 'keys_unsorted[]' <<<"$json" | while IFS= read -r key; do
             [[ -z $key ]] && die empty key detected on JSON
             jq -j --arg k "$key" '.[$k]' <<<"$json" | tf_blob "$key"
         done) || die
    cmd_mktrace <<<"$tr"
}

# chain-jsonl [-p <chain>]
cmd_chain_jsonl() {
    local line trace chain parent= n=0

    if [[ $# -eq 2 && $1 == -p ]]; then
        parent=$(cmd_rev_parse "$2") || exit 1
    elif [[ $# -ne 0 ]]; then
        die 'usage: chain-jsonl [-p <chain>]'
    fi

    while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue          # skip blank lines
        trace=$(printf '%s' "$line" | cmd_mktrace_json) \
            || die "mktrace failed at line $((n+1))"
        if [ -z "$parent" ]; then
            chain=$(cmd_chain_trace "$trace") || die
        else
            chain=$(cmd_chain_trace -p "$parent" "$trace") || die
        fi
        parent="$chain"
        n=$((n+1))
    done

    [ "$n" -gt 0 ] || die 'empty input'
    echo "$chain"
}

cmd_ls_chain() {
    [[ $# -eq 1 ]] || die 'usage: ls-chain <chain-ish>'

    local chain
    chain=$(cmd_rev_parse "$1") || exit 1
    lgit cat-file commit "$chain" | awk '
        /^$/ { exit }                          # stop at blank line (msg starts)
        $1 == "tree"   { print "trace " $2 }
        $1 == "parent" { print "parent " $2 }
    '
}

#
# Chain-ish
#
# A chain-ish is <name><suffix>. <suffix> starts at the first of ~ ^ :
# @{, none of which may appear in a ref name, so the split is
# unambiguous. Sib resolves <name> itself and hands git only full ref
# names or object ids, so git's own DWIM (tags, heads, remotes) never
# applies. <suffix> is git's.
#
#   HEAD, @          HEAD
#   refs/...         as is
#   <n>, conv/<n>    refs/conv/<n>, if it exists
#   <hex>            the commit it abbreviates
#
# A <name> that is both a conversation and a commit is ambiguous.
#

# Print the existing conversation ref <name> refers to
conv_lookup() {
    local ref
    for ref in "refs/conv/$1" "refs/conv/${1#conv/}"; do
        if lgit show-ref --verify --quiet "$ref"; then
            echo "$ref"
            return 0
        fi
    done
    return 1
}

resolve_name() {
    local name=$1 ref= hashes=

    case $name in
        HEAD|@) echo HEAD; return 0 ;;
        refs/*) echo "$name"; return 0 ;;
    esac

    ref=$(conv_lookup "$name")
    if [[ $name =~ ^[0-9a-f]{4,40}$ ]]; then
        hashes=$(lgit rev-parse --disambiguate="$name" 2>/dev/null |
                     lgit cat-file --batch-check='%(objecttype) %(objectname)' |
                     awk '$1 == "commit" { print $2 }')
    fi

    if [[ -n $ref && -n $hashes ]]; then
        echo "fatal: $name is both a conversation and a chain;" \
             "use conv/$name or a longer hash" >&2
        return 1
    elif [[ -n $ref ]]; then
        echo "$ref"
    elif [[ $hashes == *$'\n'* ]]; then
        echo "fatal: short hash $name is ambiguous" >&2
        return 1
    elif [[ -n $hashes ]]; then
        echo "$hashes"
    else
        echo "fatal: unknown chain-ish: $name" >&2
        return 1
    fi
}

resolve_rev() {
    local rev=$1 name base

    name=${rev%%[~^:]*}
    name=${name%%@\{*}

    if [[ -z $name ]]; then
        # @{n}, @{-n}: git resolves these against HEAD itself
        [[ $rev == @\{* ]] || {
            echo "fatal: unknown chain-ish: $rev" >&2
            return 1
        }
        echo "$rev"
        return 0
    fi

    base=$(resolve_name "$name") || return
    echo "$base${rev:${#name}}"
}

# Resolve a rev-list argument: [^]<rev>, <rev>..<rev>, <rev>...<rev>
resolve_arg() {
    local arg=$1 neg= op= lhs rhs

    [[ $arg == ^* ]] && { neg=^; arg=${arg#^}; }

    if [[ $arg == *...* ]]; then
        op=...
    elif [[ $arg == *..* ]]; then
        op=..
    else
        arg=$(resolve_rev "$arg") || return
        echo "$neg$arg"
        return 0
    fi

    # An empty side means HEAD to git; leave it so
    lhs=${arg%%"$op"*}
    rhs=${arg#*"$op"}
    [[ -z $lhs ]] || lhs=$(resolve_rev "$lhs") || return
    [[ -z $rhs ]] || rhs=$(resolve_rev "$rhs") || return
    echo "$neg$lhs$op$rhs"
}

cmd_rev_list() {
    local args=() arg

    for arg; do
        case $arg in
            -*) ;;
            *) arg=$(resolve_arg "$arg") || exit 1 ;;
        esac
        args+=("$arg")
    done

    lgit rev-list --reverse "${args[@]}" --
}

cmd_rev_jsonl() {
    [[ $# -ge 1 ]] || die 'usage: rev-jsonl [<rev-list-option>...] <chain-ish>'

    local empty
    empty=$(lgit hash-object -t tree /dev/null) || die

    # One git process per stage, not per chain:
    #
    #   rev-list   "<empty> <trace>" for each chain, root first
    #   diff-tree  prints that line, then ":... <blob> A<TAB><key>"
    #              for every entry of the trace
    #   awk        turns it into cat-file requests: the empty tree marks
    #              a new chain, "<blob> <key>" an entry
    #   cat-file   "<type> <size> <key>" header (key comes back as
    #              %(rest)), then the body and a newline
    #   jq         collects each chain's entries into one object
    cmd_rev_list --no-commit-header --format="$empty %T" "$@" \
        | lgit diff-tree --stdin -r --no-commit-id \
        | awk -F'\t' -v e="$empty" '
            /^:/ { split($1, m, " "); print m[4], $2; next }
            { print e }' \
        | lgit cat-file --batch='%(objecttype) %(objectsize) %(rest)' \
        | jq -R -n -c '
            # Body is <size> bytes followed by a newline
            def body($size):
                def more:
                    if utf8bytelength > $size then .[:-1]
                    else . + input + "\n" | more end;
                "" | more;

            foreach ((inputs | split(" ")), null) as $h ({};
                if $h == null then {emit: .trace}
                else
                    body($h[1] | tonumber) as $value
                    | if $h[0] == "tree" then {emit: .trace, trace: {}}
                      else del(.emit) | .trace[$h[2]] = $value end
                end;
                .emit // empty)' \
        || die "rev-jsonl failed for $*"
}

# rev-parse <chain-ish>: print the chain it names
# rev-parse --ref <name>: print the ref conversation <name> is, or
#                         would be, stored at
cmd_rev_parse() {
    local rev

    if [[ $# -eq 2 && $1 == --ref ]]; then
        case $2 in
            HEAD|@) die "$2 is not a conversation name" ;;
            refs/*) rev=$2 ;;
            *) rev=$(conv_lookup "$2") || rev=refs/conv/${2#conv/} ;;
        esac
        lgit check-ref-format "$rev" || die "invalid name: $2"
        echo "$rev"
        return 0
    fi

    [[ $# -eq 1 ]] || die 'usage: rev-parse [--ref] <chain-ish>'

    rev=$(resolve_rev "$1") || exit 1
    lgit rev-parse --verify --quiet --end-of-options "$rev^{commit}" ||
        die "not a chain: $1"
}

#
# Refs
#

# Ref names are taken literally: HEAD or a full refs/... name
check_refname() {
    [[ $1 == HEAD ]] && return 0
    [[ $1 == refs/* ]] && lgit check-ref-format "$1" && return 0
    die "not a full ref name: $1"
}

# Resolve an update-ref value. An empty or all-zero <old> means "must
# not exist" and is passed as is.
resolve_value() {
    if [[ -z $1 || $1 =~ ^0+$ ]]; then
        echo "$1"
    else
        cmd_rev_parse "$1"
    fi
}

# update-ref [-m <msg>] [--no-deref] <refname> <chain-ish> [<old>]
# update-ref [-m <msg>] [--no-deref] -d <refname> [<old>]
cmd_update_ref() {
    local opts=() del= args=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            -m) [[ $# -ge 2 ]] || die 'update-ref: -m needs a message'
                opts+=(-m "$2"); shift 2 ;;
            --no-deref) opts+=("$1"); shift ;;
            -d) del=1; shift ;;
            --) shift; break ;;
            -*) die "update-ref: unknown option $1" ;;
            *) break ;;
        esac
    done

    if [[ -n $del ]]; then
        [[ $# -ge 1 && $# -le 2 ]] ||
            die 'usage: update-ref [-m <msg>] [--no-deref] -d <refname> [<old>]'
        check_refname "$1"
        args=(-d "$1")
        [[ $# -lt 2 ]] || args+=("$(resolve_value "$2")") || exit 1
    else
        [[ $# -ge 2 && $# -le 3 ]] ||
            die 'usage: update-ref [-m <msg>] [--no-deref] <refname> <chain-ish> [<old>]'
        check_refname "$1"
        args=("$1" "$(cmd_rev_parse "$2")") || exit 1
        [[ $# -lt 3 ]] || args+=("$(resolve_value "$3")") || exit 1
    fi

    lgit update-ref --create-reflog "${opts[@]}" "${args[@]}"
}

cmd_show_ref() {
    [ $# -eq 1 ] || die 'usage: show-ref <refname>'
    check_refname "$1"
    lgit show-ref --verify --hash "$1"
}

cmd_ls_refs() {
    local prefix=${1:-refs/}
    [[ $prefix == refs/* ]] || die "not a ref prefix: $prefix"
    lgit for-each-ref --format='%(refname) %(objectname)' "$prefix"
}

# symbolic-ref [-q] [--short] <refname>
# symbolic-ref [-m <msg>] <refname> <refname>
cmd_symbolic_ref() {
    local opts=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            -m) [[ $# -ge 2 ]] || die 'symbolic-ref: -m needs a message'
                opts+=(-m "$2"); shift 2 ;;
            -q|--short) opts+=("$1"); shift ;;
            --) shift; break ;;
            -*) die "symbolic-ref: unknown option $1" ;;
            *) break ;;
        esac
    done

    [[ $# -ge 1 && $# -le 2 ]] ||
        die 'usage: symbolic-ref [-q] [-m <msg>] <refname> [<refname>]'
    check_refname "$1"
    [[ $# -lt 2 ]] || check_refname "$2"

    lgit symbolic-ref "${opts[@]}" "$@"
}

#
# dispatcher
#

usage() {
    cat <<EOF >&2
usage: sib <ask|log|show|switch|save|tool> [-h ...]
       sib edit <chain-ish>
       sib status
       sib init
       sib version
EOF
}

# Map git >= 2.46 subcommands to options older git understands
cmd_config() {
    case ${1-} in
        get) shift; set -- --get "$@" ;;
        set) shift ;;
        unset) shift; set -- --unset "$@" ;;
        list) shift; set -- --list "$@" ;;
    esac
    lgit config "$@"
}

[[ $# -lt 1 ]] && { usage; die; }

cmd="$1"; shift

case $cmd in
    -h|--help|help) usage; exit 0 ;;
esac

if [[ $cmd != init && $cmd != version ]]; then
    lgit rev-parse --resolve-git-dir "$SIB_DIR" &>/dev/null \
        || die "$SIB_DIR: not a sib storage: run \`sib init'"
fi

# We symlink /usr/bin/sib -> ../libexec/sib-core
# script_dir need to be realpath ../libexec/sib-core
script_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"


cmd_version() {
    echo "sib version $(cat -- "$script_dir/VERSION")"
}

export PATH="$script_dir:$PATH"

# Priority: Env > config > Default; vendor.<sib.vendor>.* takes
# priority over sib.{endpoint,model}
vendor=$(cmd_config get sib.vendor 2>/dev/null)
if [[ -n $vendor ]]; then
    : "${PLM_ENDPOINT:=$(cmd_config get "vendor.$vendor.endpoint" 2>/dev/null)}"
    : "${PLM_MODEL:=$(cmd_config get "vendor.$vendor.model" 2>/dev/null)}"
    : "${PLM_HEADER_CMD:=$(cmd_config get "vendor.$vendor.headerCmd" 2>/dev/null)}"
fi

: "${PLM_MODEL:=$(cmd_config get sib.model 2>/dev/null)}"
: "${PLM_MODEL:=$DEFAULT_PLM_MODEL}"

: "${PLM_ENDPOINT:=$(cmd_config get sib.endpoint 2>/dev/null)}"
: "${PLM_ENDPOINT:=$DEFAULT_PLM_ENDPOINT}"

# Tools are sent only when configured or $SIB_DIR/tools/tools.json exists
: "${PLM_TOOLS:=$(cmd_config get --type=path sib.tools 2>/dev/null)}"
[[ -n $PLM_TOOLS || ! -f $SIB_DIR/tools/tools.json ]] || PLM_TOOLS=$SIB_DIR/tools/tools.json

export PLM_MODEL PLM_ENDPOINT PLM_HEADER_CMD PLM_TOOLS

fn="cmd_${cmd//-/_}"
if declare -F "$fn" > /dev/null; then
    "$fn" "$@"
elif command -v "sib-$cmd" >/dev/null; then
    exec "sib-$cmd" "$@"
else
    echo sib: unknown command "$cmd" >&2
    echo >&2
    usage
    die
fi
