#!/usr/bin/env bash
# Available formats: plm/text(only for src)/request(only for dest)/response(only for src)
#
# plm: one item per line; see Documentation/KeyFormat.md

set -euo pipefail

NAME=$(basename -- "$0")

die() {
    printf 'err: %s\n' "$1" >&2
    exit 2
}

usage() {
    echo "Usage: $NAME [-f <text|plm|response>] [-t <plm|request>]" >&2
}

source_format="text"
dest_format="plm"

while getopts f:t: o; do
    case $o in
        f) source_format="$OPTARG" ;;
        t) dest_format="$OPTARG" ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

text_to_plm() {
    jq -Rsc '{type:"message", role:"user", content:.}'
}

# One plm line per output item; see Documentation/KeyFormat.md
response_to_plm() {
    jq -c '
      .model as $model
      | .output[]
      | (if .type == "message" then
             {role,
              content: ([.content[]? | select(.type == "output_text" or .type == "text") | .text]
                        | join("\n\n"))}
         elif .type == "function_call" then
             {call_id, name, content: .arguments}
         elif .type == "reasoning" then
             {summary: ([.summary[]? | .text] | join("\n\n")), encrypted_content}
         else
             empty
         end) as $item
      | {type} + $item
        + (if .status != null and .status != "completed" then {status} else {} end)
        + {"sib:model": $model}
      | with_entries(select(.value != null))'
}

src_to_plm() {
    case "$source_format" in
        plm)      tee ;;
        text)     text_to_plm ;;
        response) response_to_plm ;;
        request)  die "$source_format: not supported for src" ;;
        *) die "$source_format: unknown src format" ;;
    esac
}

# Build request input from a per-type whitelist; see Documentation/KeyFormat.md
plm_to_request() {
    : "${PLM_MODEL:?PLM_MODEL is not set}"
    local tools='null' input

    # Drain stdin first so a bad PLM_TOOLS does not break the pipe upstream
    input=$(cat)

    if [[ -n ${PLM_TOOLS:-} ]]; then
        [[ -f $PLM_TOOLS && -r $PLM_TOOLS ]] || die "$PLM_TOOLS: cannot read tools"
        tools=$(jq -c . -- "$PLM_TOOLS") || die "$PLM_TOOLS: cannot read tools"
        jq -e 'type == "array"' >/dev/null <<<"$tools" ||
            die "$PLM_TOOLS: tools must be a JSON array"
    fi

    # TODO: configure this
    local reasoning_summary=auto

    jq -s \
       --arg reasoning_summary "$reasoning_summary" \
       --argjson tools "$tools" \
       --arg tool_choice "${PLM_TOOL_CHOICE:-}" \
       --arg model "$PLM_MODEL" \
       --argjson stream "${PLM_USE_STREAM:-true}" \
       --arg temp "${PLM_TEMP:-}" \
       --arg top_p "${PLM_TOP_P:-}" \
       --arg fpen "${PLM_FREQ_PENALTY:-}" \
       --arg ppen "${PLM_PRES_PENALTY:-}" \
       '{
          model: $model,
          input: [ .[] |
            if .type == null then
                {type: "message", role, content}
            elif .type == "message" then
                {type, role, content}
            elif .type == "function_call" then
                {type, call_id, name, arguments: .content}
            elif .type == "function_call_output" then
                {type, call_id, output: .content}
            elif .type == "reasoning" and .encrypted_content != null then
                {type,
                 summary: (if (.summary // "") == "" then []
                           else [{type: "summary_text", text: .summary}] end),
                 encrypted_content}
            else
                empty
            end ],
          stream: $stream,
          store: false,
          reasoning: {summary: $reasoning_summary}
        }
        | if $tools != null then .tools = $tools else . end
        | if $tool_choice != "" then
              .tool_choice = (try ($tool_choice | fromjson) catch $tool_choice)
          else . end
        | if $temp  != "" then .temperature       = ($temp  | tonumber) else . end
        | if $top_p != "" then .top_p             = ($top_p | tonumber) else . end
        | if $fpen  != "" then .frequency_penalty = ($fpen  | tonumber) else . end
        | if $ppen  != "" then .presence_penalty  = ($ppen  | tonumber) else . end' \
       <<<"$input"
}

plm_to_dest() {
    case "$dest_format" in
        plm)      tee ;;
        response) die "$dest_format: not supported for dest" ;;
        request)  plm_to_request ;;
        *) die "$dest_format: unknown dest format" ;;
    esac
}

src_to_plm | plm_to_dest
