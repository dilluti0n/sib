NAME="$(basename -- "$0")"

die() {
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: ${NAME} [-1] [-n <lines>] [<chain-ish>]
  -1 Show only <chain-ish>, not its ancestors
  -n Truncate content to LINES
  -h Show this help
EOF
}

n_lines= limit=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h) usage; exit 0 ;;
        -1) limit=(--max-count=1); shift ;;
        -n) n_lines="${2:?$1 requires arg}"; shift 2 ;;
        -*) echo "unknown arg: $1" >&2; usage; exit 1 ;;
        *) break ;;
    esac
done

[[ $# -le 1 ]] || { usage >&2; die; }
target="${1:-HEAD}"
tid=$(sib rev-parse "$target" 2>/dev/null) || die invalid chain-ish "$target"

# Each chain, separated by "---"
sib rev-jsonl "${limit[@]}" "$tid" | jq -n -r -j \
    --rawfile ids <(sib rev-list "${limit[@]}" "$tid") \
    --arg n "$n_lines" '
    def rstrip_nl: if endswith("\n") then .[:-1] | rstrip_nl else . end;

    # head -n $n
    def head:
        if $n == "" then .
        else split("\n") as $lines
            | if ($n | tonumber) >= ($lines | length) then .
              else $lines[:($n | tonumber)] | map(. + "\n") | add // "" end
        end;

    ($ids | split("\n")) as $ids
    | foreach inputs as $trace (-1; . + 1; . as $i | $ids[$i] as $chain | $trace
        | if $i > 0 then "\n---\n\n" else empty end,
          "chain \($chain)\n",
          (to_entries[] | select(.key != "content")
              | "\(.key): \(.value | rstrip_nl)\n"),
          "\n",
          if has("content") then (.content | head), "\n" else empty end)
'
