set -euo pipefail

NAME="$(basename -- "$0")"

die() {
    [ $? -ne 141 ] || exit 141  # reader closed the pipe (SIGPIPE)
    [ $# -eq 0 ] || echo fatal: "$@" >&2
    exit 1
}

usage() {
    cat <<EOF
usage: ${NAME} [-t <name>] <chain-ish>
       ${NAME} [-t <name>] -f <name>
       ${NAME} -h

Move HEAD to <chain-ish>. By default, HEAD is detached at the resolved
chain
  -t  save HEAD as <name> before switch
  -f  HEAD follows <name> after switch
  -h  print this help
EOF
}

symbolic= refname=
while getopts hft: o; do
    case $o in
        h) usage; exit 0 ;;
        f) symbolic=true ;;
        t) refname="$OPTARG" ;;
        *) usage; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -eq 1 ]] || { usage >&2; exit 1; }
chain="$1"

[[ -n $refname ]] && sib save "$refname"

if [[ -n $symbolic ]]; then
    target=$(sib rev-parse --ref "$chain") || die "-f: $chain is not a name"
    sib symbolic-ref -m "switch to symbolic $chain" HEAD "$target" ||
        die "invalid name: $chain"
    echo "HEAD now follows $chain" >&2
else
    res=$(sib rev-parse "$chain" 2>/dev/null) || die "$chain is invalid"
    from=$(sib git rev-parse -q --verify --short HEAD) || from='(unborn)'
    echo "switch to $chain ($(sib git rev-parse --short "$res")) from $from" >&2
    sib update-ref -m "switch to $chain" --no-deref HEAD "$res"
fi
